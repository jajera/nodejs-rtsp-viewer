{
  "name": "nodejs-rtsp-viewer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // FFmpeg is baked into the image (see Dockerfile). Avoid apt-get on every create.
  "postCreateCommand": "npm install && (test -f .env || cp .env.example .env) && mkdir -p hls",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.eol": "\n",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.exclude": {
          "**/hls/**/*.ts": true
        }
      }
    }
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Camera Viewer",
      "onAutoForward": "notify"
    }
  },

  "remoteUser": "node",
  "containerEnv": {
    "NODE_ENV": "development",
    "PORT": "3000",
    "HLS_OUTPUT_DIR": "hls"
  },

  // Linux + LAN cameras: uncomment so RTSP reaches the camera subnet (same as compose).
  // Breaks some Mac/Windows Docker Desktop networking — leave commented unless needed.
  // "runArgs": ["--network=host"],

  "waitFor": "postCreateCommand"
}
